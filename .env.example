# EasyMind AI - Environment Configuration
# LM Studio Local Base URL (Default port is 1234)
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Preferred model ID (Leave empty to automatically detect whichever model is currently loaded in LM Studio)
LM_STUDIO_MODEL=

# Flask Web Server Settings
PORT=5000
HOST=127.0.0.1
DEBUG=False
SECRET_KEY=easymind-local-ai-offline-secret-key
